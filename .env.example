# Public frontend/API settings. Set these as Wrangler vars for the chosen environment.
APP_ORIGIN=https://urbexity.example
PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
ASSET_BASE_URL=https://media.urbexity.example
ADMIN_EMAILS=admin@example.com
EMAIL_FROM=Urbexity <noreply@example.com>

# Configure with `wrangler secret put`, never as checked-in vars:
RESEND_API_KEY=

# Provision in Cloudflare and replace the placeholder in wrangler.jsonc:
D1_DATABASE_ID=replace-with-cloudflare-d1-id
R2_BUCKET_NAME=urbexity-media
